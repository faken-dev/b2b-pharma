# -------------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=pharma_db

# -------------------------------------------------
# JWT
# -------------------------------------------------
JWT_SECRET=change_me_to_a_strong_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=30m

# -------------------------------------------------
# SENDGRID (Email service – used later)
# -------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM=no-reply@pharmab2b.com

# -------------------------------------------------
# OAUTH SETTINGS
# -------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -------------------------------------------------
# FRONTEND_URL 
# -------------------------------------------------
FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_URL=http://localhost:3000/reset-password
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
OAUTH_CALLBACK_URL=http://localhost:3000/auth

# -------------------------------------------------
# APP SETTINGS
# -------------------------------------------------
APP_URL=http://localhost:3000